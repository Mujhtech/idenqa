# Self-hosted Idenqa Core development overrides.
#
# Every value here is non-production. Copy to `.env` next to compose.yaml to
# override the compose defaults:
#   cp deploy/self-hosted/.env.example deploy/self-hosted/.env
# Docker Compose loads `.env` from the compose project directory
# (deploy/self-hosted), never the repository root.
#
# Generated secrets (API-key peppers, cursor keys, capture/outcome token keys,
# the local evidence KEK keyring, and the development CA) are deliberately not
# listed here. The one-shot `provision` service generates them into the shared
# `run-data` volume on first start and never rotates them on restart. Replace
# them with a real KMS and PKI before any production use.

# --- images and host ports --------------------------------------------------
# Local builds use `idenqa-core:${IDENQA_IMAGE_TAG}` and friends. To run the
# stack from images published by .github/workflows/images.yml instead, add
#       -f deploy/self-hosted/compose.published.yaml
# and set:
#   IDENQA_IMAGE_REPOSITORY=ghcr.io/<owner>   (default placeholder ghcr.io/OWNER)
#   IDENQA_IMAGE_TAG=<published tag>          (latest, 1.2.3, or sha-<commit>)
# `latest` is published only for stable `v*` releases; `dev` is the local
# build tag and is never published.
IDENQA_IMAGE_REPOSITORY=ghcr.io/OWNER
IDENQA_IMAGE_TAG=dev
IDENQA_IMAGE_VERSION=dev
IDENQA_IMAGE_COMMIT=unknown
IDENQA_IMAGE_DATE=unknown
IDENQA_API_HOST_PORT=8080
IDENQA_SELF_HOSTED_POSTGRES_PORT=5433
IDENQA_MINIO_API_PORT=9000
IDENQA_MINIO_CONSOLE_PORT=9001
IDENQA_CAPTURE_WEB_HOST_PORT=4173
IDENQA_ADAPTER_RUNNER_HOST_PORT=9090
IDENQA_MODEL_RUNNER_HOST_PORT=9091
IDENQA_S3_API_HOST_PORT=8081

# --- development credentials (never reuse outside local development) --------
IDENQA_POSTGRES_PASSWORD=idenqa_dev
IDENQA_MINIO_ROOT_USER=idenqa
IDENQA_MINIO_ROOT_PASSWORD=idenqa_dev_minio

# --- regional and browser bootstrap -----------------------------------------
# Must be a lowercase deployment identifier and, for the Capture Web demo, a
# canonical processing-authority code. `idenqa synthetic run` accepts the same
# value through `--region`; smoke.sh reads it from the running API.
IDENQA_REGION=tenant-local
IDENQA_LOG_LEVEL=info

# --- worker identity --------------------------------------------------------
IDENQA_WORKER_ID=self-hosted-worker

# --- optional S3-backed distribution (--profile s3) -------------------------
# `api-s3` and `worker-s3` share this MinIO namespace. Start the named pair
# together; do not run it beside the local `api` and `worker` for one database.
IDENQA_S3_BUCKET=idenqa-evidence
IDENQA_S3_PREFIX=self-hosted/evidence
IDENQA_S3_REGION=us-east-1
IDENQA_S3_WORKER_ID=self-hosted-s3-worker

# ---------------------------------------------------------------------------
# Complete API/worker environment contract (defaults applied by compose.yaml)
# ---------------------------------------------------------------------------
#
# Database and orchestration (IDENQA_DATABASE_URL is mandatory; the worker
# additionally requires IDENQA_HEADGATE_INSTALLATION_ID and
# IDENQA_HEADGATE_SCHEMA to be lowercase deployment identifiers):
#   IDENQA_ENVIRONMENT=development
#   IDENQA_DATABASE_URL=postgres://idenqa:idenqa_dev@postgres:5432/idenqa?sslmode=disable
#   IDENQA_DATABASE_ADMIN_URL=postgres://idenqa:idenqa_dev@postgres:5432/idenqa?sslmode=disable
#   IDENQA_DATABASE_MAX_CONNECTIONS=20
#   IDENQA_DATABASE_MIN_CONNECTIONS=2
#   IDENQA_HEADGATE_INSTALLATION_ID=idenqa-self-hosted
#   IDENQA_HEADGATE_SCHEMA=headgate
#   IDENQA_API_KEY_MAXIMUM_ROTATION_OVERLAP=24h
#   IDENQA_API_KEY_MAXIMUM_LIFETIME=2160h
#
# Browser/realtime bootstrap (the API requires all three together):
#   IDENQA_REGION=tenant-local
#   IDENQA_REALTIME_WEBSOCKET_URL=ws://127.0.0.1:8080/v1/capture/socket
#   IDENQA_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
#
# Local evidence (the root API and worker require both paths together; the
# worker uses the same mounted keyring for webhook signing):
#   IDENQA_EVIDENCE_LOCAL_DIRECTORY=/var/lib/idenqa/evidence
#   IDENQA_EVIDENCE_LOCAL_KEYRING_FILE=/run/idenqa/evidence-keyring.json
#
# Generated versioned keyrings (written to /run/idenqa/runtime.env by the
# provision service and sourced by the process entrypoint):
#   IDENQA_API_KEY_ACTIVE_PEPPER_VERSION=1
#   IDENQA_API_KEY_PEPPERS=1=<32 random bytes as unpadded Base64URL>
#   IDENQA_CURSOR_ACTIVE_KEY_VERSION=1
#   IDENQA_CURSOR_KEYS=1=<32 random bytes as unpadded Base64URL>
#   IDENQA_CAPTURE_TOKEN_ACTIVE_KEY_VERSION=1
#   IDENQA_CAPTURE_TOKEN_KEYS=1=<32 random bytes as unpadded Base64URL>
#   IDENQA_OUTCOME_TOKEN_ACTIVE_KEY_VERSION=1
#   IDENQA_OUTCOME_TOKEN_KEYS=1=<32 random bytes as unpadded Base64URL>
#
# Synthetic processing (development only; these fixture checks do not verify
# identity). IDENQA_PROVIDER_RUNTIME_FILE and IDENQA_MODEL_RUNTIME_FILE must
# stay unset while synthetic processing is enabled because the worker rejects
# mixed provider/model and synthetic composition:
#   IDENQA_WORKER_SYNTHETIC_PROCESSING=true
#   IDENQA_WORKER_LEASE_DURATION=10s
#   IDENQA_WORKER_RECONCILIATION_SWEEP_INTERVAL=5s
#   IDENQA_WORKER_PROGRESS_POLL_INTERVAL=500ms
#
# Optional mounted runtime files (unset by default):
#   IDENQA_PROVIDER_RUNTIME_FILE=/run/idenqa/provider-runtime.json
#   IDENQA_MODEL_RUNTIME_FILE=/run/idenqa/model-runner.json
#   IDENQA_PROPOSAL_RUNTIME_FILE=/run/idenqa/proposal-models.json
#   IDENQA_REVIEW_AUTHORITY_FILE=/run/idenqa/review-authority.json
#   IDENQA_REVIEW_ROUTING_FILE=/run/idenqa/review-routing.json
#
# The API distribution's strict environment check also accepts every worker
# setting above because the processes commonly share one dotenv file. Unknown
# IDENQA_* variables fail closed at startup.
