IDENQA_ENVIRONMENT=development
IDENQA_DATABASE_URL=postgres://idenqa:idenqa_dev@127.0.0.1:5432/idenqa?sslmode=disable
# Keep this credential out of API and worker deployments. It is for explicit
# migrations and audited administrative CLI operations only.
IDENQA_DATABASE_ADMIN_URL=postgres://idenqa:idenqa_dev@127.0.0.1:5432/idenqa?sslmode=disable
# IDENQA_DATABASE_ROLE=idenqa_runtime
IDENQA_DATABASE_MAX_CONNECTIONS=20
IDENQA_DATABASE_MIN_CONNECTIONS=2
IDENQA_DATABASE_MAX_LIFETIME=1h
IDENQA_DATABASE_MAX_IDLE_TIME=15m
IDENQA_DATABASE_CONNECT_TIMEOUT=5s
IDENQA_DATABASE_MIGRATION_TIMEOUT=5m
IDENQA_DATABASE_HEALTH_INTERVAL=10s
IDENQA_DATABASE_HEALTH_TIMEOUT=2s
# Stable and unique within the database/deployment. Changing it creates a new
# worker identity namespace; changing the schema points at different durable work.
IDENQA_HEADGATE_INSTALLATION_ID=idenqa-local
IDENQA_HEADGATE_SCHEMA=headgate
IDENQA_WORKER_VERIFICATION_CONCURRENCY=8
IDENQA_WORKER_EVIDENCE_CONCURRENCY=4
IDENQA_WORKER_DELIVERY_CONCURRENCY=8
IDENQA_WORKER_MAINTENANCE_CONCURRENCY=2
IDENQA_WORKER_VERIFICATION_RATE_LIMIT=120
IDENQA_WORKER_VERIFICATION_RATE_PERIOD=1m
IDENQA_WORKER_VERIFICATION_RATE_BURST=20
IDENQA_WORKER_VERIFICATION_TENANT_CONCURRENCY=4
IDENQA_WORKER_EVIDENCE_RATE_LIMIT=60
IDENQA_WORKER_EVIDENCE_RATE_PERIOD=1m
IDENQA_WORKER_EVIDENCE_RATE_BURST=10
IDENQA_WORKER_EVIDENCE_TENANT_CONCURRENCY=2
IDENQA_WORKER_DELIVERY_RATE_LIMIT=300
IDENQA_WORKER_DELIVERY_RATE_PERIOD=1m
IDENQA_WORKER_DELIVERY_RATE_BURST=50
IDENQA_WORKER_DELIVERY_TENANT_CONCURRENCY=8
IDENQA_WORKER_MAINTENANCE_RATE_LIMIT=30
IDENQA_WORKER_MAINTENANCE_RATE_PERIOD=1m
IDENQA_WORKER_MAINTENANCE_RATE_BURST=5
IDENQA_WORKER_MAINTENANCE_TENANT_CONCURRENCY=1
IDENQA_WORKER_LEASE_DURATION=30s
IDENQA_WORKER_SHUTDOWN_TIMEOUT=25s
IDENQA_WORKER_EMPTY_POLL_FLOOR=50ms
IDENQA_WORKER_EMPTY_POLL_CEILING=2s
IDENQA_WORKER_RECONCILIATION_SWEEP_INTERVAL=1m
IDENQA_WORKER_RECONCILIATION_BATCH_SIZE=100
IDENQA_WORKER_RECONCILIATION_ITEM_LEASE=2m
IDENQA_WORKER_PROGRESS_POLL_INTERVAL=1s
IDENQA_WORKER_CRASH_LIMIT=3
IDENQA_WORKER_RETRY_BASE=1s
IDENQA_WORKER_RETRY_CAP=1h
# Zero disables the rolling-restart memory guard.
IDENQA_WORKER_MEMORY_LIMIT_BYTES=0
IDENQA_WORKER_MEMORY_CHECK_INTERVAL=30s
# Configure both values when tenant API-key authentication is enabled. Each
# pepper is exactly 32 random bytes encoded as unpadded Base64URL. Keep retired
# versions available while credentials issued under them remain valid.
# IDENQA_API_KEY_ACTIVE_PEPPER_VERSION=1
# IDENQA_API_KEY_PEPPERS=1=<unpadded-base64url-32-byte-pepper>
# IDENQA_API_KEY_ALLOW_NO_EXPIRY=false
# IDENQA_API_KEY_MAXIMUM_LIFETIME=2160h
# IDENQA_API_KEY_MAXIMUM_ROTATION_OVERLAP=24h
# Cursor HMAC keys must be independent of API-key peppers. Keep an old key
# available until every cursor issued with it has exceeded CURSOR_TTL.
# IDENQA_CURSOR_ACTIVE_KEY_VERSION=1
# IDENQA_CURSOR_KEYS=1=<unpadded-base64url-32-byte-key>
IDENQA_CURSOR_TTL=15m
IDENQA_PROFILE_IDEMPOTENCY_RETENTION=24h
# Capture-token HMAC keys must be independent of both API-key peppers and
# cursor keys. Retain old versions until all issued tokens and their
# idempotency replay windows have expired.
# IDENQA_CAPTURE_TOKEN_ACTIVE_KEY_VERSION=1
# IDENQA_CAPTURE_TOKEN_KEYS=1=<unpadded-base64url-32-byte-key>
IDENQA_VERIFICATION_DEFAULT_TTL=24h
IDENQA_VERIFICATION_MAXIMUM_TTL=168h
IDENQA_CAPTURE_TOKEN_DEFAULT_TTL=30m
IDENQA_CAPTURE_TOKEN_MAXIMUM_TTL=2h
IDENQA_VERIFICATION_IDEMPOTENCY_RETENTION=24h
# Explicit regional data-plane identity and public browser WebSocket endpoint.
# Never infer either value from browser locale, IP, Host, or forwarding headers.
IDENQA_REGION=local
IDENQA_REALTIME_WEBSOCKET_URL=ws://127.0.0.1:8080/v1/capture/socket
IDENQA_REALTIME_TICKET_LIFETIME=30s
IDENQA_HTTP_HOST=127.0.0.1
IDENQA_HTTP_PORT=8080
IDENQA_HTTP_TLS_MODE=disabled
# IDENQA_HTTP_TLS_CERT_FILE=/run/secrets/idenqa/server.crt
# IDENQA_HTTP_TLS_KEY_FILE=/run/secrets/idenqa/server.key
IDENQA_HTTP_MAX_BODY_BYTES=1048576
IDENQA_HTTP_REQUEST_TIMEOUT=10s
IDENQA_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000
IDENQA_EVIDENCE_UPLOAD_MAXIMUM_BYTES=16777216
IDENQA_EVIDENCE_UPLOAD_INTENT_LIFETIME=15m
IDENQA_EVIDENCE_UPLOAD_ATTEMPT_TIMEOUT=10m
IDENQA_EVIDENCE_UPLOAD_ALLOWED_MEDIA_TYPES=image/jpeg,image/png
# Configure both paths to enable the root API's local evidence graph. Leave
# both empty when an independently composed provider distribution owns them.
# IDENQA_EVIDENCE_LOCAL_DIRECTORY=/var/lib/idenqa/evidence
# IDENQA_EVIDENCE_LOCAL_KEYRING_FILE=/run/secrets/idenqa/evidence-keyring.json
# The worker uses the same regional evidence configuration to execute privacy
# deletion tasks; only the object-store capability enters the deletion path.
# The independent S3 distribution uses the same mounted keyring variable, no
# local directory, and the provider settings below. AWS credentials and custom
# certificate authorities use the AWS SDK's standard external configuration.
# IDENQA_S3_BUCKET=idenqa-evidence
# IDENQA_S3_PREFIX=production/evidence
# IDENQA_S3_REGION=eu-west-1
# IDENQA_S3_ENDPOINT=https://objects.example.com
# IDENQA_S3_FORCE_PATH_STYLE=false
# IDENQA_S3_ALLOW_HTTP=false
# IDENQA_S3_CLEANUP_TIMEOUT=30s
IDENQA_EVIDENCE_PROTECTION_CLEANUP_TIMEOUT=5s
# Comma-separated native bundle/package identifiers allowed to redeem native bootstrap tokens.
# IDENQA_NATIVE_APPLICATION_IDS=dev.idenqa.capture,com.example.identity
IDENQA_SHUTDOWN_TIMEOUT=10s
IDENQA_LOG_LEVEL=info
IDENQA_LOG_FORMAT=json
# Telemetry is disabled unless a transport and collector are selected. Choose
# exactly one of grpc or http/protobuf per process; both are supported by the
# core. Insecure export is accepted only for an explicit loopback collector.
IDENQA_TELEMETRY_PROTOCOL=disabled
# IDENQA_TELEMETRY_ENDPOINT=127.0.0.1:4317
# IDENQA_TELEMETRY_INSECURE=true
# Comma-separated, percent-encoded name=value entries. Values are redacted.
# IDENQA_TELEMETRY_HEADERS=authorization=Bearer%20secret
# IDENQA_TELEMETRY_TLS_CA_FILE=/run/secrets/idenqa/collector-ca.pem
# IDENQA_TELEMETRY_TLS_CERT_FILE=/run/secrets/idenqa/collector-client.pem
# IDENQA_TELEMETRY_TLS_KEY_FILE=/run/secrets/idenqa/collector-client-key.pem
# IDENQA_TELEMETRY_TLS_SERVER_NAME=collector.example.com
IDENQA_TELEMETRY_TRACE_SAMPLE_RATIO=0.10
IDENQA_TELEMETRY_METRIC_INTERVAL=1m
IDENQA_TELEMETRY_EXPORT_TIMEOUT=10s
