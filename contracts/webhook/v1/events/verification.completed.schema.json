{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification.completed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "created_at",
    "tenant_id",
    "region",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "verification.completed"
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Idenqa webhook event data",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_id",
        "subject_id",
        "decision_id"
      ],
      "properties": {
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "decision_outcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "checks": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "state"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "outcome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
