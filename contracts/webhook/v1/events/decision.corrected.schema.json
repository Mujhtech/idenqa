{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision.corrected",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "created_at",
    "tenant_id",
    "region",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "decision.corrected"
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Idenqa webhook event data",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "verification_id",
        "previous_decision_id",
        "case_id"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previous_decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "verification_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "decided_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "previous_decision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "case_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
