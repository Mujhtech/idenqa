{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "check.completed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "created_at",
    "tenant_id",
    "region",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": "check.completed"
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Idenqa webhook event data",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_id",
        "check_id",
        "version"
      ],
      "properties": {
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "check_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "verification_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
