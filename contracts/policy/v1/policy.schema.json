{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idenqa.dev/policy/v1/policy.schema.json",
  "title": "Idenqa policy document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_major", "schema_minor", "policy_id", "revision", "verified_assurance", "rules"],
  "properties": {
    "schema_major": { "const": 1 },
    "schema_minor": { "const": 0 },
    "policy_id": { "type": "string", "pattern": "^pol_[0-9A-HJKMNP-TV-Z]{26}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "verified_assurance": { "type": "string", "maxLength": 128 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]*$" },
    "fact": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "result"],
      "properties": {
        "name": { "allOf": [{ "$ref": "#/$defs/token" }, { "maxLength": 128 }] },
        "when": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "result": { "$ref": "#/$defs/result" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "directive", "priority", "contributing_facts", "reason_codes"],
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "prohibited" } }, "required": ["state"] },
          "then": { "properties": { "directive": { "const": "fail_workflow" } } }
        },
        {
          "if": { "properties": { "directive": { "const": "complete_verified" } }, "required": ["directive"] },
          "then": { "properties": { "state": { "const": "satisfied" } } }
        },
        {
          "if": { "properties": { "directive": { "const": "complete_not_verified" } }, "required": ["directive"] },
          "then": { "properties": { "state": { "const": "not_satisfied" } } }
        },
        {
          "if": { "properties": { "directive": { "const": "complete_inconclusive" } }, "required": ["directive"] },
          "then": { "properties": { "state": { "enum": ["inconclusive", "unavailable"] } } }
        }
      ],
      "properties": {
        "state": { "enum": ["satisfied", "not_satisfied", "inconclusive", "unavailable", "prohibited"] },
        "directive": { "enum": ["complete_verified", "complete_not_verified", "complete_inconclusive", "request_input", "run_check", "retry_check", "use_fallback", "route_manual_review", "fail_workflow"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "contributing_facts": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/fact" } },
        "reason_codes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/token" }, { "maxLength": 100 }] } }
      }
    }
  }
}
